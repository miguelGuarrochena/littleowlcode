{
  "name": "little-owl-code",
  "version": "0.1.0",
  "description": "A second pair of eyes for your codebase. Keep your codebase healthy while AI writes code.",
  "keywords": [
    "code-quality",
    "architecture",
    "static-analysis",
    "codebase-health",
    "ai",
    "cli",
    "dependency-graph",
    "circular-dependencies",
    "technical-debt"
  ],
  "homepage": "https://littleowlcode.com",
  "bugs": "https://github.com/littleowlcode/little-owl-code/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littleowlcode/little-owl-code.git"
  },
  "license": "MIT",
  "author": "Little Owl Code",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "bin": {
    "little-owl": "./dist/cli.js",
    "little-owl-code": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.13.1",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.6",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@9.15.4"
}
